# Copy to backend/.env before running `docker compose up`.
# Compose uses this file for variable interpolation and passes values to the API.
NODE_ENV=development
PORT=3000

# Must be >= 16 characters (JWT validation requirement).
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Leave DISABLE_SEED=true unless DEFAULT_ADMIN_WALLET is configured.
DISABLE_SEED=true
DEFAULT_ADMIN_WALLET=

# Optional host port overrides
DB_PORT_HOST=5432
REDIS_PORT_HOST=6379

# --- Database backups (issue #1714) -----------------------------------------
# Interpolated by docker-compose.yml into the backup sidecar, postgres (WAL
# archiving) and backend services. See docs/database-backup-restore.md.
#
# REQUIRED when BACKUP_ENCRYPTION_ENABLED=true (the default). Use a long random
# value; keep it in a secret manager in production.
BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-long-random-backup-passphrase
BACKUP_ENCRYPTION_ENABLED=true

# Offsite storage (AWS S3). Empty bucket = keep backups local only.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=postgres
BACKUP_S3_REGION=us-east-1
BACKUP_S3_STORAGE_CLASS=STANDARD_IA
BACKUP_S3_SSE=aws:kms
BACKUP_S3_KMS_KEY_ID=

# Retention / freshness / schedules.
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_HOURS=26
BACKUP_SCHEDULE_CRON=0 2 * * *
BACKUP_BASE_SCHEDULE_CRON=30 3 * * 0
BACKUP_VERIFY_SCHEDULE_CRON=0 4 1 * *

# Failure alerts.
BACKUP_ALERT_WEBHOOK=
BACKUP_ALERT_ON_SUCCESS=false

# S3 credentials for local testing only; production uses an IAM/task role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
