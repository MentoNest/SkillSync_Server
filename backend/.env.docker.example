# Copy to backend/.env before running `docker compose up`.
# Compose uses this file for variable interpolation and passes values to the API.
NODE_ENV=development
PORT=3000

# Must be >= 16 characters (JWT validation requirement).
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Leave DISABLE_SEED=true unless DEFAULT_ADMIN_WALLET is configured.
DISABLE_SEED=true
DEFAULT_ADMIN_WALLET=

# Optional host port overrides
DB_PORT_HOST=5432
REDIS_PORT_HOST=6379
