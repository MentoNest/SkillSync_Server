# Copy to .env.test or export these variables before `npm run test:e2e`.
NODE_ENV=test

# Isolated PostgreSQL instance used by the database-backed E2E suites.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=skillsync
DB_PASSWORD=skillsync_test
DB_NAME=skillsync_test
TEST_DATABASE_URL=postgresql://skillsync:skillsync_test@localhost:5433/skillsync_test
DB_MIGRATIONS_RUN=false

# Isolated Redis instance.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=skillsync:test:

# Auth settings shared by the auth and profile E2E suites.
JWT_SECRET=test-only-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
AUTH_NONCE_TTL_SECONDS=1
DISABLE_SEED=true
