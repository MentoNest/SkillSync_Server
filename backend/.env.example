# Application
NODE_ENV=development
PORT=3000
APP_NAME=SkillSync
# Comma-separated exact browser origins; localhost origins are also allowed in development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Exact proxy hop count or trusted subnet expression if deployed behind a proxy; never "true".
TRUST_PROXY=

# Local development secrets. Generate ENCRYPTION_KEY with: openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_SECRET=
ENCRYPTION_KEY=
SEARCH_HASH_SALT=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=skillsync
DB_POOL_SIZE=10
DB_SSL=false

# Feature Flags
FEATURE_FLAG_NEW_MATCHING=false
FEATURE_FLAG_AI_RECOMMENDATIONS=false

# Redis (access token blacklist, rate limits, nonces)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=skillsync:

# Backup encryption is opt-in; set a separate key when enabled.
BACKUP_ENCRYPTION=false
BACKUP_ENCRYPTION_KEY=

# Bootstrap seed (#1319)
# Set to true to skip the admin role/user seed entirely (e.g. in CI).
DISABLE_SEED=false
# Stellar wallet address of the bootstrap administrator.
DEFAULT_ADMIN_WALLET=
# Wallet used instead of DEFAULT_ADMIN_WALLET when NODE_ENV=test.
TEST_ADMIN_WALLET=
SEED_DEMO_DATA=false

# Audit logging (#1320) - retention window in days.
AUDIT_LOG_RETENTION_DAYS=90
