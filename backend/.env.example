NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=skillsync
JWT_AUDIENCE=skillsync-api
DATABASE_URL=postgres://skillsync:skillsync@localhost:5432/skillsync
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=false
COOKIE_SECURE=false
SWAGGER_ENABLED=true
RATE_LIMIT_AUTH_LIMIT=50
RATE_LIMIT_ANON_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60
METRICS_BASIC_AUTH_USER=
METRICS_BASIC_AUTH_PASS=
METRICS_ALLOWED_IPS=

# --- Field-level encryption (AES-256-GCM) ---
# Generate keys with: openssl rand -base64 32
ENCRYPTION_KEY_ID=k1
ENCRYPTION_KEY=
# Retired keys kept for decrypting old values: "k0:<base64>,..."
ENCRYPTION_OLD_KEYS=
# Key for blind indexes (exact-match search on encrypted columns)
ENCRYPTION_INDEX_KEY=

# --- Graceful shutdown ---
SHUTDOWN_TIMEOUT_MS=30000

# --- Backups ---
BACKUP_STATUS_FILE=/var/backups/skillsync/status.json
