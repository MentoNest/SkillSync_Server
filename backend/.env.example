# ── Application ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=SkillSync
CORS_ORIGINS=http://localhost:3000
# Trusted hops (number) or CIDR ranges. Never "true" or "*".
TRUST_PROXY=

# ── Auth ───────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
# Required in production, minimum 32 characters.
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_PRIVATE_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ── PostgreSQL ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=skillsync
# Connection pool (issue default: 10-20 connections)
DB_POOL_MIN=10
DB_POOL_MAX=20
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Explicit override for schema sync; defaults to on outside production.
# DB_SYNCHRONIZE=true
DB_MAX_RETRIES=5
DB_RETRY_DELAY_MS=3000
DB_SLOW_QUERY_MS=1000

# ── Redis ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=skillsync:
REDIS_CONNECT_TIMEOUT_MS=10000

# ── Feature flags ──────────────────────────────────────────────
FEATURE_FLAG_NEW_MATCHING=false
FEATURE_FLAG_AI_RECOMMENDATIONS=false
