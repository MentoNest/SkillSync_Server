# Copy this file to .env and fill in real values. Never commit the real .env.

NODE_ENV=development
PORT=3000

# --- Database (#1141) ---------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=skillsync

# Force synchronize on/off explicitly; otherwise it's on outside production.
# DB_SYNCHRONIZE=false

# SSL (enable for most managed Postgres providers in production)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Connection pool (default 10-20)
DB_POOL_MIN=10
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000

# Slow query logging threshold (ms)
DB_SLOW_QUERY_MS=1000

# Connection retry (used by TypeOrmModule.forRootAsync at boot)
DB_MAX_RETRIES=5
DB_RETRY_DELAY_MS=3000

# --- Redis (#1142) --------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=skillsync:
REDIS_CONNECT_TIMEOUT_MS=10000

# --- Auth / misc -----------------------------------------------------------
JWT_SECRET=your-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=false
ENABLE_SWAGGER=true
