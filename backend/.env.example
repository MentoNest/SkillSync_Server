# Application environment: development | test | production
NODE_ENV=development
PORT=3000
# Required. Must be at least 32 characters; use a unique secret per deployment.
JWT_SECRET=change-me-to-a-32-character-minimum-secret
FRONTEND_DOMAIN=http://localhost:3000

# Graceful shutdown
# Seconds to wait for in-flight requests before forcing exit. Defaults to 30000.
SHUTDOWN_TIMEOUT_MS=30000

# Startup admin seed
DEFAULT_ADMIN_WALLET=
# Set this to a test-only wallet in test environments.
DISABLE_SEED=false

# Auth roles and token lifetimes
# Comma-separated wallet addresses; these roles are embedded in JWTs at login.
AUTH_ADMIN_ADDRESSES=
AUTH_MENTOR_ADDRESSES=
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=604800
# AUTH_NONCE_TTL_SECONDS=300

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=skillsync
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=
# DB_POOL_SIZE=20
# DB_RETRY_ATTEMPTS=5
# DB_RETRY_DELAY_MS=3000
# DB_MIGRATIONS_RUN=false
# DB_SLOW_QUERY_MS=200

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=skillsync:

# --- Production hardening ---------------------------------------------------
# Exact frontend origins, comma separated. Required in production; no wildcards.
CORS_ALLOWED_ORIGINS=https://app.skillsync.example,https://admin.skillsync.example
# Express trust proxy: false, true, a hop count (e.g. 1) or an IP/CIDR list.
TRUST_PROXY=1
# Rate limits per window (production defaults: 50 authenticated / 10 anonymous).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTHENTICATED_MAX=50
RATE_LIMIT_UNAUTHENTICATED_MAX=10
# Swagger/GraphQL playground are forced off in production.
SWAGGER_ENABLED=true
GRAPHQL_PLAYGROUND_ENABLED=false
# Cookies are always Secure + HttpOnly + SameSite=Strict in production.
COOKIE_SAME_SITE=strict
# COOKIE_SECURE=false

# Featured mentors
FEATURED_MENTOR_LIMIT=10
FEATURED_MENTOR_DURATION_DAYS=30

# Profile completeness
PROFILE_COMPLETENESS_CACHE_TTL_SECONDS=300
PROFILE_COMPLETENESS_SUGGESTION_THRESHOLD=80

# Demo data seed (npm run seed:demo)
# Set to false to run the command without creating demo users and sessions.
SEED_DEMO_DATA=true

# Chat attachments
CHAT_UPLOAD_DIR=uploads/chat
CHAT_UPLOAD_PUBLIC_PATH=/uploads/chat
